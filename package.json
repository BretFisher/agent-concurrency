{
  "name": "stack-prune-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --legal-comments=external",
    "check": "npm run typecheck && npm test && npm run build && npm run test:bundle",
    "test:bundle": "node --experimental-strip-types --test tests/bundle-smoke.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
